{
  "name": "bcps-elogbook-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Automated discovery mapper and Excel-to-draft uploader for the BCPS e-logbook portal",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "map": "ts-node src/mapper/run.ts",
    "map:resume": "ts-node src/mapper/run.ts --resume",
    "verify-map": "ts-node src/mapper/verify.ts",
    "validate-excel": "ts-node src/excel/validate.ts",
    "legacy:upload:dry-run": "ts-node src/uploader/run.ts",
    "legacy:upload:drafts": "ts-node src/uploader/run.ts --execute",
    "workbook:dry-run": "ts-node src/uploader/run-workbook.ts",
    "workbook:execute": "ts-node src/uploader/run-workbook.ts --execute",
    "test": "jest --runInBand",
    "report": "ts-node src/mapper/report.ts",
    "recon:login": "ts-node src/mapper/recon-login.ts",
    "recon:form": "ts-node src/mapper/recon-form.ts",
    "app": "ts-node src/app/server.ts"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "playwright": "^1.47.0",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.15",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
