# Copy this file to .env and fill in real values. Never commit .env.

# BCPS e-portal credentials
BCPS_USER_TYPE=
BCPS_USERNAME=
BCPS_PASSWORD=

# Base URL of the portal
BASE_URL=https://eportal.bcps.edu.bd

# Paths for login and form
LOGIN_PATH=/login
FORM_PATH=/e-logbook/logbook-entry/add

# Safety limits for exploration
MAX_DEPTH=6
MAX_OPTIONS_PER_FIELD=50

# Optional runtime toggles
HEADLESS=false
